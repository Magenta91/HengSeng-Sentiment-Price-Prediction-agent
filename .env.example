# Copy to .env and fill in. NEVER commit .env.
APP_ENV=production
LOG_LEVEL=INFO

# Storage: use 'postgres' for production, 'memory' for local testing
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database_name

APIFY_API_TOKEN=your_apify_api_token_here
EXA_API_KEY=your_exa_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash
FINBERT_ENABLED=false

# csv | yfinance. Verify ticker coverage first: python -m scripts.check_market_coverage
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=
MARKET_DATA_CSV_DIR=data/market

MODEL_PATH=model_artifacts/random_forest_model.joblib
MODEL_METADATA_PATH=model_artifacts/model_metadata.json

DEFAULT_LOOKBACK_DAYS=10
CORS_ORIGINS=https://your-frontend-domain.vercel.app

